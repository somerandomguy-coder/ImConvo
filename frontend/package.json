{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd .. && .venv/bin/python -m api.main --host 127.0.0.1 --port 8001",
    "dev:all": "node scripts/ensure-dev-clean.mjs && concurrently -k -n API,WEB -c yellow,cyan \"npm run dev:api\" \"npm run dev\"",
    "build": "next build",
    "start": "next start",
    "start:api": "cd .. && .venv/bin/python -m api.main --host 127.0.0.1 --port 8001",
    "start:all": "concurrently -k -n API,WEB -c yellow,cyan \"npm run start:api\" \"npm run start\"",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "canvas-confetti": "^1.9.3",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
